        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Student\nactor \&quot;Administrator\&quot; as AdministratorActor\nparticipant \&quot;Administrator\&quot; as AdministratorClass\nparticipant Equipment\nparticipant Booking\n\nStudent -&gt; Equipment: checkAvailability()\nEquipment --&gt; Student: Boolean\n\nalt [true]\n    Student -&gt; Booking: createBooking()\n    Booking --&gt; Student: true\nelse [false]\n    note over Student, Booking: No booking is created\n        end\n\ngroup Cancellation\n    Student -&gt; Booking: cancelBooking()\n    Booking -&gt; Equipment: markAvailable()\n    note over Booking: Booking is retained with status Cancelled\n    note over Equipment: Equipment changes from Booked to Available\nend\n\ngroup Administrator use cases\n    AdministratorActor -&gt; AdministratorClass: addEquipment()\n    AdministratorActor -&gt; Equipment: markAvailable()\n    alt [Equipment is not Booked]\n        AdministratorActor -&gt; Equipment: markUnavailable()\n    else [Equipment is Booked]\n        AdministratorActor -&gt; Equipment: markUnavailable()\n        note over AdministratorActor, Equipment: markUnavailable() is rejected\n    end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v0tcGh0Lxm2tAN19R5kP-1">
