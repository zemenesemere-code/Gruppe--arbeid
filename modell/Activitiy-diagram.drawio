        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nstart\nif (Select use case?) then (Check availability)\n  :Check availability;\n  stop\nelseif (Book equipment)\n  :Check availability;\n  if (Is equipment available?) then (Yes)\n    :Create booking;\n  else (No)\n    :Booking is not created;\n  endif\n  stop\nelseif (Cancel booking)\n  :Cancel booking;\n  :Retain booking with status Cancelled;\n  :Equipment changes from Booked to Available;\n  stop\nelse (Administrator)\n  if (Administrator action?) then (Add equipment)\n    :Add equipment;\n    :New equipment starts as Available;\n  elseif (Mark equipment Available)\n    :Mark equipment Available;\n  else (Mark equipment Unavailable)\n    if (Is equipment Booked?) then (Yes)\n      :Reject attempt to mark equipment Unavailable;\n    else (No)\n      :Mark equipment Unavailable;\n    endif\n  endif\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="activity-source">
